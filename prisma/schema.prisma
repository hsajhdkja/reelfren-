generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// 角色:普通用户 / 管理员
enum Role {
  USER
  ADMIN
}

model Drama {
  id          Int        @id @default(autoincrement())
  title       String     @db.VarChar(200)
  category    String     @db.VarChar(50)
  rating      String     @db.VarChar(10)
  description String     @db.Text
  image       String     @db.VarChar(200)
  tag         String     @db.VarChar(50)
  published   Boolean    @default(true) // 上下架开关:false = 游客看不到
  embedding   String?    @db.Text // 语义向量(JSON 数组文字,由 AI 生成;null = 还没生成)

  episodes    Episode[]
  favorites   Favorite[]

  @@index([category])
  @@index([title])
}

model Episode {
  id         Int             @id @default(autoincrement())
  number     Int
  title      String          @db.VarChar(100)
  videoUrl   String          @db.VarChar(500)
  dramaId    Int
  drama      Drama           @relation(fields: [dramaId], references: [id], onDelete: Cascade)
  progresses WatchProgress[]

  @@unique([dramaId, number])
  @@index([dramaId])
}

model User {
  id           Int             @id @default(autoincrement())
  email        String          @unique @db.VarChar(200)
  passwordHash String          @db.VarChar(200)
  role         Role            @default(USER) // 新增:角色,默认普通人
  createdAt    DateTime        @default(now())
  favorites    Favorite[]
  progresses   WatchProgress[]
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  dramaId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drama     Drama    @relation(fields: [dramaId], references: [id], onDelete: Cascade)

  @@unique([userId, dramaId])
}

model WatchProgress {
  id          Int      @id @default(autoincrement())
  userId      Int
  episodeId   Int
  positionSec Float
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
}
